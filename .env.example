# Oxylabs Web Scraper API Configuration
# Sign up at https://oxylabs.io to get your credentials
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password

# Upstash Redis Configuration
# Used for rate limiting and usage tracking
# Sign up at https://upstash.com to get your credentials
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Clerk Authentication
# Sign up at https://clerk.com and create a new application
# Get your keys from the Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URL Configuration
# These define the routing for authentication pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Vercel Postgres Configuration
# These are automatically populated by Vercel when you add the Postgres addon
# For local development, you can set up a local Postgres database or use Vercel's development database
POSTGRES_URL=postgres://default:password@host:5432/verceldb
POSTGRES_PRISMA_URL=postgres://default:password@host:5432/verceldb?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://default:password@host:5432/verceldb
POSTGRES_USER=default
POSTGRES_HOST=your-postgres-host.postgres.vercel-storage.com
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=verceldb

# Vercel Analytics (Optional)
# Automatically provided by Vercel
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id
