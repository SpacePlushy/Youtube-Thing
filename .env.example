# Transcript Extraction API Configuration
# Required for transcript extraction features
OXYLABS_USERNAME=your_api_username
OXYLABS_PASSWORD=your_api_password

# AI Formatting API Configuration (REQUIRED for AI features)
# Used for transcript formatting and enhancement
CEREBRAS_API_KEY=your_ai_api_key

# Clerk Authentication (REQUIRED for authentication features)
# Get your keys at https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Redis Configuration (REQUIRED for rate limiting and guest tracking)
# Connect Redis service in Vercel or provide credentials
UPSTASH_REDIS_REST_URL=your_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_redis_rest_token

# Optional: Other API configurations (currently unused)
# DEEPGRAM_API_KEY=your_deepgram_api_key
# BRIGHT_DATA_API_TOKEN=your_bright_data_token