# Oxylabs Web Scraper API Configuration
# Sign up at https://oxylabs.io to get your credentials
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password

# Google Gemini API key for transcript formatting
# Get your API key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Groq API key for ultra-fast transcript formatting
# Get your FREE API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Optional: Other API configurations (currently unused)
# DEEPGRAM_API_KEY=your_deepgram_api_key
# BRIGHT_DATA_API_TOKEN=your_bright_data_token