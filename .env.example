# Oxylabs Web Scraper API Configuration
# Sign up at https://oxylabs.io to get your credentials
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password

# Cerebras API key for ultra-fast transcript formatting (REQUIRED for AI features)
# Get your API key at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key

# Clerk Authentication (REQUIRED for authentication features)
# Get your keys at https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Upstash Redis Configuration (REQUIRED for rate limiting and guest tracking)
# Connect Upstash in Vercel or get credentials at https://upstash.com/
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Optional: Other API configurations (currently unused)
# DEEPGRAM_API_KEY=your_deepgram_api_key
# BRIGHT_DATA_API_TOKEN=your_bright_data_token